flowchart TB
  subgraph COMERCIAL["Comercial — Cotação COT"]
    A1[Identificação + Rota + KM]
    A2[Tipo operação CIOT]
    A3[Flags ANTT: composição / AD / retorno]
    A4[Tabela NTC — preço comercial]
    A5[Motor calculate-freight]
    A1 --> A2 --> A3 --> A4 --> A5
  end

  subgraph MOTOR["Motor de precificação"]
    M1[Piso ANTT = km×CCD + CC]
    M2[PAG base = max piso, tabela+over]
    M3[Custos diretos operacionais]
    M4[Repasse risco — fora gross-up]
    M5[Gross-up → FAT total]
    M6[Lucro alvo = CD × margem%]
    M1 --> M2 --> M3 --> M4 --> M5 --> M6
  end

  A5 --> MOTOR

  subgraph UI_Q["UI Quote — exibição"]
    Q1[Painel PAG]
    Q2[Painel FAT]
    Q3[Painel Lucro + Compliance]
  end

  MOTOR --> UI_Q

  subgraph OPS["Operacional — OS"]
    O1[Converter COT → OS]
    O2[carreteiro_antt + pag_previsto]
    O3[Despacho + Gerar CIOT]
    O4[CIOT: frete pago + piso]
    O1 --> O2 --> O3 --> O4
  end

  UI_Q --> O1

  subgraph FIN["Financeiro"]
    F1[FAT kanban — a receber]
    F2[PAG kanban — a pagar]
    F3[Parcelas + comprovantes]
    F1 --- F2
  end

  O4 --> F2
  O1 --> F1

  subgraph REGRAS["Regras invioláveis"]
    R1[PAG real ≥ piso quando sujeito]
    R2[FAT ≠ piso — são camadas diferentes]
    R3[CIOT bloqueia se PAG < piso]
  end

  MOTOR -.-> REGRAS
  O4 -.-> REGRAS
